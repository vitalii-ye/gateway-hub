# Copy to .env and fill in the values marked <like-this>.
# Hostnames below match the docker-compose service names; if you run a service
# outside Docker, swap them for localhost.

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_EVENT_STATUS_PREFIX=event_status
REDIS_GUILD_RULES_PREFIX=guild_rules
REDIS_AUDIT_LOGS_PREFIX=audit_logs
REDIS_RATE_LIMIT_PREFIX=rate_limit

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=events
RABBITMQ_EXCHANGE=events
RABBITMQ_ROUTING_KEY=events

# --- Discord bot service (rules-engine -> discord-bot) ---
DISCORD_BOT_URL=http://discord-bot:8001
DISCORD_BOT_EXECUTE_PATH=/v1/messages
DISCORD_BOT_TIMEOUT_SECONDS=10
DISCORD_BOT_TOKEN=<your-discord-bot-token>

# --- Supabase (server-side key used by gateway and rules-engine; keep secret) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>

# --- Gateway ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Rules-engine worker ---
WORKER_PREFETCH=10
LOG_LEVEL=INFO
# How long cached guild rules live before re-reading Supabase (empty = forever)
REDIS_GUILD_RULES_TTL_SECONDS=60

# --- Control page (Next.js build args consumed by docker-compose) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
# Discord application (client) ID — same app as the bot token; used to build
# the "Add bot to server" invite URL in the dashboard.
NEXT_PUBLIC_DISCORD_CLIENT_ID=<your-discord-application-id>
